---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DarkList from '../components/DarkList.astro';
import Steps from '../components/Steps.astro';
import Quote from '../components/Quote.astro';
import CtaBand from '../components/CtaBand.astro';
import photo from '../assets/dpf-cleaning-system.jpg';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import { seo, hero, facts, process, why, whatWeClean, whoWeCleanFor, cta } from '../data/dpf-cleaning';

interface Fact {
  label: string;
  value: string;
  href?: string;
  detail?: string;
}

const quickFacts: Fact[] = [];
if (facts.turnaround) quickFacts.push({ label: 'Turnaround', value: facts.turnaround });
if (facts.startingPrice) quickFacts.push({ label: 'Price', value: facts.startingPrice });
if (!facts.turnaround || !facts.startingPrice) {
  quickFacts.push({
    label: facts.pricingFallbackLabel,
    value: facts.pricingFallback,
    href: site.phone.href,
    detail: site.phone.display,
  });
}
quickFacts.push({ label: facts.dropOffLabel, value: `${site.hours.days}, ${site.hours.time}` });
---

<Base title={seo.title} description={seo.description}>
  <Hero crumb={hero.crumb} title={hero.title} lead={hero.lead} facts={hero.facts}>
    <figure slot="aside" class="photo">
      <Image src={photo} alt={hero.photoAlt} width={400} loading="eager" />
      <figcaption>{hero.photoCaption}</figcaption>
    </figure>
  </Hero>

  <section class="section">
    <div class="wrap">
      <ul class="facts">
        {
          quickFacts.map((fact) => (
            <li class="card">
              <span class="label">{fact.label}</span>
              <strong>{fact.value}</strong>
              {fact.href && <a href={fact.href}>{fact.detail}</a>}
            </li>
          ))
        }
      </ul>

      <div class="section-head">
        <h2 class="h2">{process.title}</h2>
        <p class="lead">{process.intro}</p>
      </div>
      <Steps steps={process.steps} />
    </div>
  </section>

  <DarkList title={why.title} text={why.text} rows={why.rows} />

  <section class="section">
    <div class="wrap">
      <div class="lists">
        <div>
          <h2 class="list-title">{whatWeClean.title}</h2>
          <ul class="chips">
            {whatWeClean.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="list-title">{whoWeCleanFor.title}</h2>
          <ul class="chips">
            {whoWeCleanFor.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <Quote review={reviews.adam} />
    </div>
  </section>

  <CtaBand title={cta.title} text={cta.text} />
</Base>

<style>
  .photo {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .photo img {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .photo figcaption {
    color: var(--muted);
    font-size: 1rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 72px);
    list-style: none;
  }

  .facts li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 24px 28px;
  }

  .facts .label {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 600;
  }

  .facts strong {
    color: var(--navy);
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .facts a {
    justify-self: start;
    font-weight: 700;
  }

  .lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 36px 64px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .list-title {
    margin-bottom: 20px;
    font-size: clamp(1.625rem, 1.45rem + 0.8vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.12;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 18px;
    background: var(--tint);
    border-radius: 999px;
    color: var(--navy);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
  }
</style>
