---
/** Numbered steps in a row. */
import type { TitleText } from '../data/types';

interface Props {
  steps: TitleText[];
}

const { steps } = Astro.props;
---

<ol>
  {
    steps.map((step, index) => (
      <li>
        <span class="number" aria-hidden="true">
          {index + 1}
        </span>
        <h3 class="h3">{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 32px;
    list-style: none;
  }

  li {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 12px;
  }

  .number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--red);
    border-radius: 50%;
    color: var(--white);
    font-family: var(--font-head);
    font-size: 1.375rem;
    font-weight: 700;
  }

  p {
    font-size: 1.0625rem;
  }
</style>
