---
/** Call and directions buttons pinned to the bottom of the screen on phones. */
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="callbar">
  <a class="btn btn--primary btn--small call" href={site.phone.href}>
    <Icon name="phone" />
    <span>Call the shop</span>
  </a>
  <a class="btn btn--outline btn--small" href={site.directionsUrl} target="_blank" rel="noopener">Directions</a>
</div>

<style>
  .callbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    display: flex;
    gap: 10px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--white);
    border-top: 1px solid var(--line);
    box-shadow: 0 -6px 20px rgba(18, 40, 76, 0.1);
  }

  .callbar .btn {
    flex: 1 1 0;
    min-height: 52px;
    padding-inline: 12px;
  }

  .callbar .call {
    flex-grow: 1.3;
  }

  @media (min-width: 720px) {
    .callbar {
      display: none;
    }
  }
</style>
