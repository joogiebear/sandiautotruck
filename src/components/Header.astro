---
import { Image } from 'astro:assets';
import logo from '../assets/logo-black.png';
import Icon from './Icon.astro';
import { site } from '../data/site';

const { pathname } = Astro.url;
const isCurrent = (href: string) => pathname === href || `${pathname}/` === href;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/">
      <Image src={logo} alt={`${site.name}, home`} width={156} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--primary btn--small phone" href={site.phone.href}>
      <Icon name="phone" />
      <span>{site.phone.display}</span>
    </a>

    <details class="menu">
      <summary>
        <span class="visually-hidden">Menu</span>
        <span class="icon-open"><Icon name="menu" size={22} /></span>
        <span class="icon-close"><Icon name="close" size={22} /></span>
      </summary>
      <nav class="menu-panel" aria-label="Main">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 12px;
  }

  .logo {
    flex: none;
    display: block;
  }

  .logo img {
    width: auto;
    height: 44px;
  }

  .nav-desktop {
    display: none;
    gap: 4px 28px;
    font-size: 1rem;
    font-weight: 600;
  }

  .nav-desktop a {
    padding: 12px 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-desktop a[aria-current='page'] {
    color: var(--red);
    box-shadow: inset 0 -3px 0 var(--red);
  }

  .phone {
    display: none;
    margin-left: auto;
    white-space: nowrap;
  }

  .menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--white);
    border: 1px solid var(--field-line);
    border-radius: 12px;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu .icon-close,
  .menu[open] .icon-open {
    display: none;
  }

  .menu[open] .icon-close {
    display: block;
  }

  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    padding: 8px var(--gutter) 20px;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 16px 28px rgba(18, 40, 76, 0.12);
  }

  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .menu-panel a[aria-current='page'] {
    color: var(--red);
  }

  @media (min-width: 720px) {
    .bar {
      padding-block: 16px;
    }

    .logo img {
      height: 56px;
    }

    .phone {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .nav-desktop {
      display: flex;
    }

    .phone {
      margin-left: 0;
    }

    .menu {
      display: none;
    }
  }
</style>
