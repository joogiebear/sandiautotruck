---
/** The customer reviews as a row of cards. */
import { allReviews } from '../data/reviews';
import { site } from '../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="section section--tint" id="reviews">
  <div class="wrap">
    <div class="head">
      <h2 class="h2">{title}</h2>
      {
        site.googleReviewsUrl && (
          <a class="arrow-link" href={site.googleReviewsUrl} target="_blank" rel="noopener">
            Read our Google reviews
          </a>
        )
      }
    </div>
    <ul>
      {
        allReviews.map((review) => (
          <li>
            <figure class="card">
              <blockquote>“{review.quote}”</blockquote>
              <figcaption>{review.name}<span> · {review.context}</span></figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 40px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    list-style: none;
  }

  li {
    display: grid;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 32px);
  }

  blockquote {
    color: var(--navy);
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    line-height: 1.45;
  }

  figcaption {
    margin-top: auto;
    color: var(--navy);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  figcaption span {
    color: var(--muted);
    font-weight: 500;
  }
</style>
