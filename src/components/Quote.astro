---
/** One customer review, shown large. */
import type { Review } from '../data/types';

interface Props {
  review: Review;
  /** "band" runs the full width under a section. "card" is a white card, for beside a page opener. */
  variant?: 'band' | 'card';
}

const { review, variant = 'band' } = Astro.props;
---

<figure class={variant}>
  <blockquote>“{review.quote}”</blockquote>
  <figcaption>{review.name}<span> · {review.context}</span></figcaption>
</figure>

<style>
  figure {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 48px;
    padding: clamp(24px, 4vw, 40px) clamp(24px, 4vw, 48px);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }

  blockquote {
    flex: 1 1 30rem;
    color: var(--navy);
    font-family: var(--font-head);
    font-size: clamp(1.3125rem, 1.15rem + 0.8vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: pretty;
  }

  figcaption {
    color: var(--navy);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  figcaption span {
    color: var(--muted);
    font-weight: 500;
  }

  .card {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(24px, 3.5vw, 40px);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .card blockquote {
    flex: none;
    font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.4375rem);
  }
</style>
