# Copy this file to .env for local work. On Cloudflare Pages, set the same
# names under Settings > Environment variables.

# Access key from https://web3forms.com (free). Turns on the appointment form.
# Without it the site shows "call or email us" in place of the form.
PUBLIC_WEB3FORMS_KEY=

# Optional. Token from Cloudflare Web Analytics, to count visits without cookies.
PUBLIC_CF_ANALYTICS_TOKEN=
